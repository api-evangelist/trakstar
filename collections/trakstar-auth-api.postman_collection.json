          "id": "1791a5ed-132a-4076-9f0b-c3c60b88b464",
          "name": "Authorize User (SSO)",
          "request": {
            "name": "Authorize User (SSO)",
            "description": {
              "content": "Generates a pre-formed SSO login URL for a user to authenticate into the Trakstar Learn application. Useful for single sign-on integrations and for checking if a user exists by email or username.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<long>",
                  "description": "The Mindflash ID of the user to log in."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "The Mindflash username of the user."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "The email address of the user."
                }
              ],
              "variable": [
                {
                  "description": "Your company subdomain name",
                  "type": "any",
                  "value": "{{companyName}}",
                  "key": "companyName"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
